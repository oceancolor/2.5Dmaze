# 迷宫寻宝 · 游戏服务器（06 §12）
# 安装：cp deploy/maze.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now maze
# 前提：Node ≥ 22.13（内置 node:sqlite）；代码在 /srv/maze；配置在 /etc/maze/maze.env；数据在 /var/lib/maze

[Unit]
Description=Maze Quest game server (maze.aiquiz.games)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maze
Group=maze
WorkingDirectory=/srv/maze
EnvironmentFile=/etc/maze/maze.env
ExecStart=/usr/bin/node server/main.mjs
Restart=always
RestartSec=2
# 收到 SIGTERM 后 server/main.mjs 会关监听、关库再退出
KillSignal=SIGTERM
TimeoutStopSec=10

# 加固：只允许写数据目录
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/maze
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
