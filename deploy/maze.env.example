# 复制到 /etc/maze/maze.env（chmod 640，属主 root:maze）。变量含义见 server/main.mjs 文件头。
HOST=127.0.0.1
PORT=5173
DB_PATH=/var/lib/maze/maze.db
PUBLIC_ORIGIN=https://maze.aiquiz.games
TRUST_PROXY=1
STATIC_CACHE=public, max-age=300
# ALLOWED_ORIGINS=          额外跨域来源（逗号分隔）；app://maze（Electron 壳）已默认包含
# MIN_CLIENT_VERSION=0.3.0  低于此版本的客户端上传返回 426
NODE_ENV=production
# 「记住 key」的主密钥（32 字节 base64）。生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 不进仓库、不进数据库、不进备份；丢了它，已「记住」的 key 全部解不开（玩家重新填一次即可）。不设则只能「仅本次会话」。
MASTER_KEY=
# 大模型对话日志（JSONL，按日期 / 对局分文件，不含 key）。须在 ReadWritePaths=/var/lib/maze 之下；设 off 关闭
LLM_LOG_DIR=/var/lib/maze/llm-logs
LLM_LOG_DAYS=30
