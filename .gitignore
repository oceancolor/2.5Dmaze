# 依赖与构建产物
node_modules/
dist/
build/
*.tsbuildinfo

# 本地环境 / 密钥（本项目纪律：Key 只存本地代理进程，绝不入库）
.env
.env.*
*.key
*.pem

# 美术管线中间产物（Blender 4× 原始渲染、任务清单）；成品图集在 assets/atlas/，入库
.cache/
__pycache__/
*.pyc

# 本地跑测试 / 校验时的临时输出（PowerShell 输出常被 CLIXML 吞，习惯写文件再读）
npm_test.txt

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# WorkBuddy 项目数据：只保留 memory（决策日志），其余不入库
.workbuddy/*
!.workbuddy/memory/
.workbuddy/memory/*
!.workbuddy/memory/*.md
